# =====================================================================
#  UEBA — barcha sozlamalar shu faylda. Kodda qattiq yozilgan qiymat yo'q.
#
#  Ishlatish:   cp .env.example .env    va quyidagilarni to'ldiring:
#                 MONGO_URI, DB_NAME        — DLP bazasi
#                 LOCAL_MONGO_URI, RABBITMQ_HOST — Docker'da servis nomlari,
#                                                  serverda localhost
#  O'zgartirgandan keyin:  docker compose up -d
#  (`restart` YETARLI EMAS — env_file faqat konteyner yaratilganda o'qiladi)
#  Chegaralarni (MIN_DOW_SAMPLES, DAYS_WINDOW) o'zgartirsangiz — qayta o'qiting.
# =====================================================================

# --- Asosiy MongoDB (DLP bazasi) — FAQAT O'QILADI ---
# Bizning kod bu bazaga hech qachon yozmaydi. Foydalanuvchiga faqat o'qish
# huquqi yetarli: clients, groups, agentsessions.
MONGO_URI=mongodb://DLP-SERVER-MANZILI:27017/
DB_NAME=DLP-BAZA-NOMI

# Ish kuni manbasi: agent sessiyalari (ulanish/uzilish) collectioni.
# Har yozuv bitta (xodim, kompyuter, kun) uchun.
SESSION_COLLECTION=agentsessions
# Maydon nomlari — DLP o'zgartirsa faqat shu qatorlarga tegiladi
SESSION_CONNECT_FIELD=connectTime
SESSION_DISCONNECT_FIELD=disconnectTime
SESSION_DATE_FIELD=dateStr
SESSION_DATE_FORMAT=%d.%m.%Y
SESSION_REASON_FIELD=disconnectReason

# --- Mahalliy MongoDB (barcha yozuvlar shu yerga) ---
# Docker'da: mongodb://mongo:27017   |   serverda: mongodb://localhost:27017
LOCAL_MONGO_URI=mongodb://mongo:27017
LOCAL_DB_NAME=ueba_local

# Mahalliy collection nomlari
COL_RAW_TRAIN=raw_data_for_train
COL_TRIGGER_DATA=trigger_data
COL_BASELINE=baseline
COL_BASELINE_RUNS=baseline_runs
COL_RESULTS=results
COL_TRAINING_JOBS=training_jobs
COL_TRIGGER_RUNS=trigger_runs

# --- RabbitMQ ---
# Docker'da: rabbitmq   |   serverda: localhost
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
QUEUE_NAME=ueba_jobs
WORKER_COUNT=3
# Job xato bersa necha marta qayta urinish, keyin tashlab yuboriladi
MAX_RETRIES=3

# --- API server ---
# Docker'da 0.0.0.0 (tashqaridan ko'rinishi uchun), aks holda 127.0.0.1
API_HOST=0.0.0.0
API_PORT=8000
# /api/results sahifasi: default hajm va eng katta ruxsat etilgani
API_PAGE_SIZE=100
API_PAGE_MAX=5000

# --- Pipeline ---
# O'qitish oynasi (kun). Kattalashtirish baseline'ni barqarorroq qiladi.
DAYS_WINDOW=90
# Trigger qancha vaqtda bir ishga tushadi (soat)
TRIGGER_INTERVAL_HOURS=5
# Birinchi o'tishda (cursor yo'q bo'lganda) qancha orqaga qaraydi (soat).
# Butun tarixni bir marta olib kelmoqchi bo'lsangiz vaqtincha 2160 (90 kun)
# qo'yib, birinchi o'tishdan keyin 5 ga qaytaring.
LOOKBACK_HOURS=5
# Mongo cursor'dan bir partiyada nechta hujjat o'qiladi
BATCH_SIZE=100
# Manbadan o'qishda qayta urinishlar va ular orasidagi kutish (soniya)
SOURCE_READ_RETRIES=2
SOURCE_READ_RETRY_DELAY=2
# Kunda bitta hodisa bo'lsa, tugash vaqti = boshlanish + shuncha soat
SINGLE_EVENT_STAY_HOURS=1
# Natijalar tarixi necha kun saqlanadi
RESULTS_RETENTION_DAYS=365
# Nechta baseline versiyasi saqlanadi (eskilari o'chiriladi)
BASELINE_KEEP_VERSIONS=5
# Nechta trigger o'tishi tarixi saqlanadi
TRIGGER_KEEP_RUNS=50
# Bir martalik skriptlar bir partiyada nechta hujjat yozadi
BULK_BATCH_SIZE=500

# --- Loglar ---
# Docker'da loyiha ichidagi logs/, serverda masalan /var/log/ueba
# (papka ochilmasa dastur to'xtamaydi — faqat konsolga yozadi)
LOG_DIR=logs
LOG_FILE=ueba.log
LOG_MAX_MB=5
LOG_BACKUPS=3

# --- Vaqt mintaqasi ---
# Ilova vaqti SERVERNING tizim soatiga emas, shu qatorga bog'liq.
# DLP mahalliy vaqtni saqlaydi — mintaqa mos kelmasa oyna chegaralari siljiydi.
# Nomi `TZ` emas: `TZ` operatsion tizimniki va u .env ni bosib ketardi.
# Bo'sh qoldirilsa tizim mintaqasi ishlatiladi.
APP_TIMEZONE=Asia/Tashkent

# --- Vaqt tekshiruvi (ishga tushishda) ---
# Ilova va manba server soati shundan ko'p farq qilsa xato deb belgilanadi (soniya)
CLOCK_SKEW_WARN_SEC=300
# Mintaqa tekshiruvi faqat ma'lumot shu muddatdan yangi bo'lsa ma'noli (soat)
TIME_CHECK_FRESH_HOURS=24

# --- Anomaliya qoidasi ---
# Baseline uchun hafta kuniga minimal kun soni. Kamaytirilsa ko'proq kun
# baholanadi, lekin norma ishonchsizroq bo'ladi.
MIN_DOW_SAMPLES=3
# Ish oynasi kengligi: mean ± T·sigma. Oynadan tashqaridagi faollik chetlanish.
ANOMALY_Z_THRESHOLD=1.0
# zOut shu qiymatga yetganda daraja balli 100 bo'ladi
ANOMALY_Z_FULL_SCALE=3.0

# --- Detector vaznlari (0..1) ---
# 0 = "soya rejim": detector ishlaydi, natijaga yoziladi, riskScore ga
# ta'sir qilmaydi. Izohda qolsa kodning defaulti (1.0) ishlaydi.
# DETECTOR_WEIGHT_WORKING_HOURS=1.0

# --- Xavf jadvali (kuzatuvdagi xodimlar) ---
# "Oxirgi xavf" ustuni necha kunlik yig'indi
RISK_RECENT_DAYS=7
# Sparkline'dagi nuqtalar soni (oxirgi shuncha kun)
RISK_TREND_POINTS=30
# Oxirgi xavf shu chegaralardan oshsa xodim belgisi rangi o'zgaradi
RISK_LEVEL_HIGH=50
RISK_LEVEL_MEDIUM=20

# /api/health bazani tekshirishda qancha kutadi (soniya).
# Qisqa bo'lishi shart: baza yotsa dashboard muzlab qolmasligi kerak.
HEALTH_PING_TIMEOUT=2

# --- Dashboard ---
# Ochilganda ko'rsatiladigan sana oralig'i (kun)
DASHBOARD_RANGE_DAYS=30
# "E'tibor talab qiladigan kunlar" ro'yxatida nechta karta
DASHBOARD_MAX_ISSUES=20
# Retrain ketayotganda dashboard holatni qancha tez so'raydi (ms)
DASHBOARD_POLL_MS=400
# Tugagach "100% Tugadi" ekranda qancha turadi (ms)
DASHBOARD_PROGRESS_HOLD_MS=2500
# Grafikdagi bitta kun ustunining kengligi (px) — o'zgarmas, kun ko'paysa scroll
CHART_COLUMN_WIDTH=34
# "Umumiy manzara" matritsasidagi katak kengligi (px)
CHART_CELL_WIDTH=18
# 0-100 ballik darajani so'zga o'giradigan chegaralar
SEVERITY_HIGH=75
SEVERITY_MEDIUM=50
SEVERITY_LOW=25
